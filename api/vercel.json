{
  "rewrites": [
    { "source": "/api/kanban", "destination": "/api/kanban" }
  ],
  "headers": [
    {
      "source": "/api/kanban",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://raelenev.github.io" },
        { "key": "Access-Control-Allow-Methods", "value": "POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    }
  ],
  "functions": {
    "api/kanban.js": {
      "memory": 128,
      "maxDuration": 10
    }
  }
}
